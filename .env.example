# Copie para .env (local) ou cadastre no painel da Vercel. NUNCA envie o .env ao GitHub.

# Chave da API do Google Gemini (obrigatória). Gere no Google AI Studio.
GEMINI_API_KEY=

# Modelo do Gemini (opcional). Se vazio, usa gemini-2.5-flash. Confirme o nome atual na documentação do Google.
GEMINI_MODEL=

# Origens autorizadas a chamar a API, separadas por vírgula (opcional).
# Exemplo: https://seu-site.webflow.io  — se vazio, qualquer origem é aceita (bom só para testes).
ALLOWED_ORIGINS=
